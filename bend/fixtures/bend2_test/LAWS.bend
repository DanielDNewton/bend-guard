# Rule 7: outside log-only mode, a recursive delete (rm -r, Remove-Item -Recurse, git clean) of a folder inside c:/users/user/bend2_test, or containing it, that is not under c:/users/user/bend2_test/tmp is denied.
law tree_delete_only_tmp:
  for +x: T.Ctx
  for +m: T.Meaning
  for t: String
  for a: T.ClefAnswer
  for +as1: List<&2, T.Action>
  for +q: T.Path
  for +as2: List<&2, T.Action>
  for h0: {Call.Ctx.log_only(x) == False{} : Bool}
  for h1: {Meaning.actions(m) == List.append(&2, T.Action, as1, T.DeleteTree{q} <> as2) : List<&2, T.Action>}
  for h2: {Path.overlaps(q, T.Path{"c", ["users", "user", "bend2_test"]}) == True{} : Bool}
  for h3: {Path.under(q, Path.child(T.Path{"c", ["users", "user", "bend2_test"]}, "tmp")) == False{} : Bool}
  {Verdict.is_deny(Guard.run_m(Rules.table(), x, m, t, a)) == True{} : Bool}

# Outside log-only mode, a plain read of a file that no rule names, that is not protected or the key file, not behind a link and in no double-check zone, is allowed whatever Clef says (when the project and home folders were read).
law reads_allowed:
  for +x: T.Ctx
  for +t: String
  for +a: T.ClefAnswer
  for +p: T.Path
  for h0: {Path.is_sentinel(Call.Ctx.root(x)) == False{} : Bool}
  for h0b: {Path.is_sentinel(Call.Ctx.home(x)) == False{} : Bool}
  for h2: {Guard.in_rule_zone(Rules.table(), p) == False{} : Bool}
  for h3: {Protect.covers(Rules.table(), x, p) == False{} : Bool}
  for h4: {Path.overlaps(p, Protect.key_file(Call.Ctx.home(x))) == False{} : Bool}
  for h5: {Call.Ctx.log_only(x) == False{} : Bool}
  for h6: {Guard.no_rule_names(Rules.table(), p) == True{} : Bool}
  for h7: {Guard.no_link(x, p) == True{} : Bool}
  {Verdict.is_allow(Guard.run_m(Rules.table(), x, T.Known{[T.Read{p}]}, t, a)) == True{} : Bool}
