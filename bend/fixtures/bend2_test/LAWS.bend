# bend-guard: project laws for c:/users/user/bend2_test (BEND_RULES.md).
# Generated by tools/gen.mjs from bend/templates/; proven in PROOF.bend, each
# by one generic law of bend/laws/rules. Project rules are not enforced in
# log-only mode (D8), so each Deny law says "outside log-only mode".

import Base
import ../core/Types.bend as T
import ../core/Verdict.bend as Verdict
import ../core/Path.bend as Path
import ../core/Meaning.bend as Meaning
import ../core/Call.bend as Call
import ../core/Protect.bend as Protect
import ../core/Guard.bend as Guard
import ./Rules.bend as Rules

# Rule 1: outside log-only mode, a call that changes anything under c:/users/user/bend2_test/specs is denied.
law specs_protected:
  for +x: T.Ctx
  for +m: T.Meaning
  for t: String
  for a: T.ClefAnswer
  for +p: T.Path
  for h0: {Call.Ctx.log_only(x) == False{} : Bool}
  for h1: {Meaning.changes(m, p) == True{} : Bool}
  for h2: {Path.under(p, Path.child(T.Path{"c", ["users", "user", "bend2_test"]}, "specs")) == True{} : Bool}
  {Verdict.is_deny(Guard.run_m(Rules.table(), x, m, t, a)) == True{} : Bool}

