# bend-guard: proofs of the project laws in LAWS.bend. Generated by
# tools/gen.mjs from bend/templates/. Each proof instantiates one generic law
# of bend/laws/rules: the table is split as pre ++ [Project{root, rs1 ++
# [rule] ++ rs2}] ++ post, which computes to Rules.table().

import Base
import ../core/Types.bend as T
import ../laws/rules/LAWS.bend as RulesLaws
import ../laws/rules/PROOF.bend as RulesProof
import ./Rules.bend as Rules
import ./LAWS.bend as Laws

def Laws.specs_protected(x, m, t, a, p, h0, h1, h2):
  RulesLaws.rule_nochange_denies([], [], T.Path{"c", ["users", "user", "bend2_test"]},
    [],
    [T.NoReadOrChange{".env"}, T.NoReadOrChange{"secrets"}, T.NoChange{"build"}, T.NoChange{"dist"}, T.NoForcePush{}, T.NoPushTo{"main"}, T.TreeDeleteOnlyUnder{"tmp"}],
    "specs", x, m, t, a, p, h0, h1, h2)

def Laws.env_protected(x, m, t, a, p, h0, h1, h2):
  RulesLaws.rule_noread_change_denies([], [], T.Path{"c", ["users", "user", "bend2_test"]},
    [T.NoChange{"specs"}],
    [T.NoReadOrChange{"secrets"}, T.NoChange{"build"}, T.NoChange{"dist"}, T.NoForcePush{}, T.NoPushTo{"main"}, T.TreeDeleteOnlyUnder{"tmp"}],
    ".env", x, m, t, a, p, h0, h1, h2)

def Laws.env_unreadable(x, m, t, a, as1, q, as2, h0, h1, h2):
  RulesLaws.rule_noread_read_denies([], [], T.Path{"c", ["users", "user", "bend2_test"]},
    [T.NoChange{"specs"}],
    [T.NoReadOrChange{"secrets"}, T.NoChange{"build"}, T.NoChange{"dist"}, T.NoForcePush{}, T.NoPushTo{"main"}, T.TreeDeleteOnlyUnder{"tmp"}],
    ".env", x, m, t, a, as1, q, as2, h0, h1, h2)

