    [T.NoChange{"specs"}, T.NoReadOrChange{".env"}, T.NoReadOrChange{"secrets"}, T.NoChange{"build"}, T.NoChange{"dist"}, T.NoForcePush{}],
    [T.TreeDeleteOnlyUnder{"tmp"}],
    "main", x, m, t, a, as1, dir, force, all, r1, r2, unsure, as2, h0, h1, h2)

def Laws.tree_delete_only_tmp(x, m, t, a, as1, q, as2, h0, h1, h2, h3):
  RulesLaws.rule_tree_delete_denies([], [], T.Path{"c", ["users", "user", "bend2_test"]},
    [T.NoChange{"specs"}, T.NoReadOrChange{".env"}, T.NoReadOrChange{"secrets"}, T.NoChange{"build"}, T.NoChange{"dist"}, T.NoForcePush{}, T.NoPushTo{"main"}],
    [],
    "tmp", x, m, t, a, as1, q, as2, h0, h1, h2, h3)

def Laws.reads_allowed(x, t, a, p, h0, h0b, h2, h3, h4, h5, h6, h7):
  RulesLaws.read_allowed(Rules.table(), x, t, a, p, h0, h0b, h2, h4, h6, h7)
