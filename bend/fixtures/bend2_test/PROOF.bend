def Laws.build_protected(x, m, t, a, p, h0, h1, h2):
  RulesLaws.rule_nochange_denies([], [], T.Path{"c", ["users", "user", "bend2_test"]},
    [T.NoChange{"specs"}, T.NoReadOrChange{".env"}, T.NoReadOrChange{"secrets"}],
    [T.NoChange{"dist"}, T.NoForcePush{}, T.NoPushTo{"main"}, T.TreeDeleteOnlyUnder{"tmp"}],
    "build", x, m, t, a, p, h0, h1, h2)

def Laws.dist_protected(x, m, t, a, p, h0, h1, h2):
