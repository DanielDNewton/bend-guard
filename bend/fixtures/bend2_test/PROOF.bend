def Laws.force_push_denied(x, m, t, a, as1, dir, all, refs, unsure, as2, h0, h1, h2):
  RulesLaws.rule_force_push_denies([], [], T.Path{"c", ["users", "user", "bend2_test"]},
    [T.NoChange{"specs"}, T.NoReadOrChange{".env"}, T.NoReadOrChange{"secrets"}, T.NoChange{"build"}, T.NoChange{"dist"}],
    [T.NoPushTo{"main"}, T.TreeDeleteOnlyUnder{"tmp"}],
    x, m, t, a, as1, dir, all, refs, unsure, as2, h0, h1, h2)

def Laws.push_main_denied(x, m, t, a, as1, dir, force, all, r1, r2, unsure, as2, h0, h1, h2):
