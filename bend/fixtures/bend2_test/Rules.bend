# bend-guard: the rule table (design.md component 3). Generated by
# tools/gen.mjs from bend/templates/Rules.bend and the approved projects'
# sort.json; do not edit by hand. One T.Project per approved project: its
# normalised root (lower case) and its hard rules, in BEND_RULES.md order.

import Base
import ../core/Types.bend as T

def table() -> List<&2, T.Project>:
  [
    T.Project{T.Path{"c", ["users", "user", "bend2_test"]}, [
      T.NoChange{"specs"},
      T.NoReadOrChange{".env"},
      T.NoReadOrChange{"secrets"},
      T.NoChange{"build"},
      T.NoChange{"dist"},
      T.NoForcePush{},
      T.NoPushTo{"main"},
      T.TreeDeleteOnlyUnder{"tmp"}
    ]}
  ]
