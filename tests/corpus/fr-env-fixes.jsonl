{"name":"F5+ Set-ItemProperty HKCU:\\Environment","tool":"PowerShell","args":{"command":"Set-ItemProperty -Path HKCU:\\Environment -Name PATH -Value x"},"expect":"deny","why":"design 28: lasting environment change"}
