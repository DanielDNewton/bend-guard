{"name":"F5+ machine environment key","tool":"PowerShell","args":{"command":"Set-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment' -Name PATH -Value x"},"expect":"deny","why":"design 28: lasting environment change"}
