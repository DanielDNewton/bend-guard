// F5: the user environment in the registry is read by every later process (PATH,
// GIT_CONFIG_GLOBAL, NODE_OPTIONS). Same class as git config writes (ADJ-1), which are refused.
{"name":"F5 setx GIT_CONFIG_GLOBAL","tool":"Bash","args":{"command":"setx GIT_CONFIG_GLOBAL C:/x"},"expect":"deny","why":"design 28 and ADJ-1: a lasting setting that runs code later"}
