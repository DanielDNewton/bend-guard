{"name":"pwsh: Get-Content README.md -EA Stop","tool":"PowerShell","args":{"command":"Get-Content README.md -EA Stop"},"expect":"allow","why":"P11: -EA Stop"}
{"name":"pwsh: Remove-Item tmp\\x -ErrorAction Ignore","tool":"PowerShell","args":{"command":"Remove-Item tmp\\x -ErrorAction Ignore"},"expect":"allow","why":"P11: -ErrorAction Ignore"}
{"name":"pwsh: Get-Item src -WarningAction Continue","tool":"PowerShell","args":{"command":"Get-Item src -WarningAction Continue"},"expect":"allow","why":"P11: -WarningAction"}
{"name":"pwsh: Get-ChildItem -ErrorAction Inquire","tool":"PowerShell","args":{"command":"Get-ChildItem -ErrorAction Inquire"},"expect":"ask","why":"P11: -ErrorAction Inquire prompts, not modelled"}
{"name":"pwsh: Get-ChildItem -OutVariable x","tool":"PowerShell","args":{"command":"Get-ChildItem -OutVariable x"},"expect":"ask","why":"P11: -OutVariable is refused"}
{"name":"pwsh: Get-ChildItem -PipelineVariable x","tool":"PowerShell","args":{"command":"Get-ChildItem -PipelineVariable x"},"expect":"ask","why":"P11: -PipelineVariable is refused"}
{"name":"pwsh: Get-ChildItem -ErrorAction","tool":"PowerShell","args":{"command":"Get-ChildItem -ErrorAction"},"expect":"ask","why":"P11: -ErrorAction needs a value"}
// P11: Select-String reads its -Path files
{"name":"pwsh: Select-String -Path src\\*.ts -Pattern TODO","tool":"PowerShell","args":{"command":"Select-String -Path src\\*.ts -Pattern TODO"},"expect":"allow","why":"P11: Select-String with a wildcard reads the folder"}
{"name":"pwsh: Select-String TODO src\\app.ts","tool":"PowerShell","args":{"command":"Select-String TODO src\\app.ts"},"expect":"allow","why":"P11: positional pattern then path"}
{"name":"pwsh: Get-Content srcapp.ts | Select-String TODO","tool":"PowerShell","args":{"command":"Get-Content srcapp.ts | Select-String TODO"},"expect":"allow","why":"P11: Select-String on the pipeline is Inert"}
{"name":"pwsh: Select-String -Path .env -Pattern x","tool":"PowerShell","args":{"command":"Select-String -Path .env -Pattern x"},"expect":"deny","why":"P11: reading .env (rule 2)"}
{"name":"pwsh: sls x secrets\\a.txt","tool":"PowerShell","args":{"command":"sls x secrets\\a.txt"},"expect":"deny","why":"P11: sls reads secrets (rule 2)"}
{"name":"pwsh: Select-String -Path src\\a.ts","tool":"PowerShell","args":{"command":"Select-String -Path src\\a.ts"},"expect":"ask","why":"P11: no pattern is given"}
// P11: Copy-Item and Move-Item as cp and mv
{"name":"pwsh: Copy-Item src\\a.ts src\\b.ts","tool":"PowerShell","args":{"command":"Copy-Item src\\a.ts src\\b.ts"},"expect":"allow","why":"P11: Copy-Item"}
{"name":"pwsh: Move-Item src\\old.ts src\\new.ts","tool":"PowerShell","args":{"command":"Move-Item src\\old.ts src\\new.ts"},"expect":"allow","why":"P11: Move-Item"}
{"name":"pwsh: cp a b","tool":"PowerShell","args":{"command":"cp a b"},"expect":"allow","why":"P11: cp is Copy-Item under PowerShell"}
{"name":"pwsh: mv a b","tool":"PowerShell","args":{"command":"mv a b"},"expect":"allow","why":"P11: mv is Move-Item under PowerShell"}
{"name":"pwsh: Copy-Item -Path src\\a.ts -Destination tmp","tool":"PowerShell","args":{"command":"Copy-Item -Path src\\a.ts -Destination tmp"},"expect":"allow","why":"P11: Copy-Item -Destination"}
{"name":"pwsh: Copy-Item -Recurse src tmp\\src","tool":"PowerShell","args":{"command":"Copy-Item -Recurse src tmp\\src"},"expect":"allow","why":"P11: Copy-Item -Recurse"}
{"name":"pwsh: Copy-Item src\\a.ts specs\\a.ts","tool":"PowerShell","args":{"command":"Copy-Item src\\a.ts specs\\a.ts"},"expect":"deny","why":"P11: a copy into specs (rule 1)"}
{"name":"pwsh: Copy-Item -Path src\\a.ts -Destination specs","tool":"PowerShell","args":{"command":"Copy-Item -Path src\\a.ts -Destination specs"},"expect":"deny","why":"P11: a copy into specs by -Destination (rule 1)"}
{"name":"pwsh: Move-Item specs\\a.md tmp\\","tool":"PowerShell","args":{"command":"Move-Item specs\\a.md tmp\\"},"expect":"deny","why":"P11: moving out of specs changes specs (rule 1)"}
{"name":"pwsh: Copy-Item .env tmp\\x","tool":"PowerShell","args":{"command":"Copy-Item .env tmp\\x"},"expect":"deny","why":"P11: copying .env reads it (rule 2)"}
{"name":"pwsh: Copy-Item src\\*.ts tmp","tool":"PowerShell","args":{"command":"Copy-Item src\\*.ts tmp"},"expect":"ask","why":"P11: wildcards are not modelled here"}
{"name":"pwsh: Copy-Item src\\a.ts","tool":"PowerShell","args":{"command":"Copy-Item src\\a.ts"},"expect":"ask","why":"P11: no destination (the current folder) is not modelled"}
{"name":"pwsh: Move-Item a b c","tool":"PowerShell","args":{"command":"Move-Item a b c"},"expect":"ask","why":"P11: more positional arguments than -Path and -Destination"}
// P11: New-Item, mkdir, Add-Content, Out-File
{"name":"pwsh: New-Item -ItemType Directory -Force src\\utils","tool":"PowerShell","args":{"command":"New-Item -ItemType Directory -Force src\\utils"},"expect":"allow","meaning":"MakeDir","why":"P11: New-Item -ItemType Directory is MakeDir"}
{"name":"pwsh: New-Item -ItemType Directory x","tool":"PowerShell","args":{"command":"New-Item -ItemType Directory x"},"expect":"allow","why":"P11: New-Item -ItemType Directory"}
{"name":"pwsh: New-Item x.txt","tool":"PowerShell","args":{"command":"New-Item x.txt"},"expect":"allow","why":"P11: New-Item makes a file by default (Write)"}
{"name":"pwsh: New-Item -Path x.txt -ItemType File -Value hi","tool":"PowerShell","args":{"command":"New-Item -Path x.txt -ItemType File -Value hi"},"expect":"allow","why":"P11: New-Item -ItemType File -Value"}
{"name":"pwsh: New-Item -ItemType Directory specs\\x","tool":"PowerShell","args":{"command":"New-Item -ItemType Directory specs\\x"},"expect":"deny","why":"P11: making a folder in specs (rule 1)"}
{"name":"pwsh: New-Item -ItemType File BEND_RULES.md -Force","tool":"PowerShell","args":{"command":"New-Item -ItemType File BEND_RULES.md -Force"},"expect":"deny","why":"P11: overwriting BEND_RULES.md (self-protection)"}
{"name":"pwsh: New-Item -ItemType HardLink -Path x -Target y","tool":"PowerShell","args":{"command":"New-Item -ItemType HardLink -Path x -Target y"},"expect":"ask","meaning":"hard link","why":"P11: hard links stay Unknown"}
{"name":"pwsh: New-Item -ItemType SymbolicLink -Path x -Target y","tool":"PowerShell","args":{"command":"New-Item -ItemType SymbolicLink -Path x -Target y"},"expect":"ask","why":"P11: symbolic links stay Unknown"}
{"name":"pwsh: New-Item -ItemType Junction -Path x -Target y","tool":"PowerShell","args":{"command":"New-Item -ItemType Junction -Path x -Target y"},"expect":"ask","why":"P11: junctions stay Unknown"}
{"name":"pwsh: New-Item -Path src -Name x.txt","tool":"PowerShell","args":{"command":"New-Item -Path src -Name x.txt"},"expect":"ask","why":"P11: -Name is not modelled"}
{"name":"pwsh: mkdir src\\x","tool":"PowerShell","args":{"command":"mkdir src\\x"},"expect":"allow","why":"P11: mkdir under PowerShell is New-Item -ItemType Directory"}
{"name":"pwsh: md specs\\y","tool":"PowerShell","args":{"command":"md specs\\y"},"expect":"deny","why":"P11: md in specs (rule 1)"}
{"name":"pwsh: Add-Content log.txt \"line\"","tool":"PowerShell","args":{"command":"Add-Content log.txt \"line\""},"expect":"allow","meaning":"Write","why":"P11: Add-Content writes"}
{"name":"pwsh: Add-Content BEND_RULES.md x","tool":"PowerShell","args":{"command":"Add-Content BEND_RULES.md x"},"expect":"deny","why":"P11: Add-Content to BEND_RULES.md (self-protection)"}
{"name":"pwsh: Out-File out.txt","tool":"PowerShell","args":{"command":"Out-File out.txt"},"expect":"allow","why":"P11: Out-File writes"}
{"name":"pwsh: Get-ChildItem | Out-File -FilePath list.txt -Append","tool":"PowerShell","args":{"command":"Get-ChildItem | Out-File -FilePath list.txt -Append"},"expect":"allow","why":"P11: Out-File -FilePath -Append"}
{"name":"pwsh: Out-File ~\\.bashrc","tool":"PowerShell","args":{"command":"Out-File ~\\.bashrc"},"expect":"deny","why":"P11: Out-File to a shell profile (protected)"}
{"name":"pwsh: Out-File specs\\a.md -Encoding utf8","tool":"PowerShell","args":{"command":"Out-File specs\\a.md -Encoding utf8"},"expect":"deny","why":"P11: Out-File into specs (rule 1)"}
{"name":"pwsh: Out-File","tool":"PowerShell","args":{"command":"Out-File"},"expect":"ask","why":"P11: Out-File needs a path"}
{"name":"pwsh: \"hello\" | Out-File notes.txt","tool":"PowerShell","args":{"command":"\"hello\" | Out-File notes.txt"},"expect":"ask","why":"P11: a quoted string as a command is not read by the lexer"}
