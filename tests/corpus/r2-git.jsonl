{"name":"pwsh: Get-Date -Format yyyy-MM-dd","tool":"PowerShell","args":{"command":"Get-Date -Format yyyy-MM-dd"},"expect":"allow","why":"P11: Get-Date"}
{"name":"pwsh: Get-PSDrive C","tool":"PowerShell","args":{"command":"Get-PSDrive C"},"expect":"allow","why":"P11: Get-PSDrive"}
{"name":"pwsh: Get-Content a.txt | Select-Object -First 5","tool":"PowerShell","args":{"command":"Get-Content a.txt | Select-Object -First 5"},"expect":"allow","why":"P11: Select-Object"}
{"name":"pwsh: Get-ChildItem src | Select-Object -ExpandProperty Name","tool":"PowerShell","args":{"command":"Get-ChildItem src | Select-Object -ExpandProperty Name"},"expect":"allow","why":"P11: Select-Object -ExpandProperty"}
{"name":"pwsh: Get-Content src\\app.ts | Measure-Object -Line","tool":"PowerShell","args":{"command":"Get-Content src\\app.ts | Measure-Object -Line"},"expect":"allow","why":"P11: Measure-Object -Line"}
{"name":"pwsh: Get-ChildItem src | Group-Object Extension","tool":"PowerShell","args":{"command":"Get-ChildItem src | Group-Object Extension"},"expect":"allow","why":"P11: Group-Object"}
{"name":"pwsh: Get-Process | Format-Table -AutoSize","tool":"PowerShell","args":{"command":"Get-Process | Format-Table -AutoSize"},"expect":"allow","why":"P11: Format-Table"}
{"name":"pwsh: Get-Item src | Format-List","tool":"PowerShell","args":{"command":"Get-Item src | Format-List"},"expect":"allow","why":"P11: Format-List"}
{"name":"pwsh: Get-ChildItem | Out-String -Width 200","tool":"PowerShell","args":{"command":"Get-ChildItem | Out-String -Width 200"},"expect":"allow","why":"P11: Out-String"}
{"name":"pwsh: Get-ChildItem src | Where-Object Name -like 'a*'","tool":"PowerShell","args":{"command":"Get-ChildItem src | Where-Object Name -like 'a*'"},"expect":"allow","why":"P11: Where-Object simple form"}
