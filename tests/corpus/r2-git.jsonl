{"name":"pwsh: Get-CimInstance -ClassName Win32_OperatingSystem","tool":"PowerShell","args":{"command":"Get-CimInstance -ClassName Win32_OperatingSystem"},"expect":"allow","why":"P11: Get-CimInstance -ClassName"}
{"name":"pwsh: Get-WmiObject -Class Win32_Process","tool":"PowerShell","args":{"command":"Get-WmiObject -Class Win32_Process"},"expect":"allow","why":"P11: Get-WmiObject -Class"}
{"name":"pwsh: Get-WmiObject -Class Win32_Process -ComputerName x","tool":"PowerShell","args":{"command":"Get-WmiObject -Class Win32_Process -ComputerName x"},"expect":"ask","why":"P11: -ComputerName is not modelled"}
{"name":"pwsh: Get-CimInstance -Query x","tool":"PowerShell","args":{"command":"Get-CimInstance -Query x"},"expect":"ask","why":"P11: -Query is not modelled"}
{"name":"pwsh: Stop-Process -Name node","tool":"PowerShell","args":{"command":"Stop-Process -Name node"},"expect":"ask","why":"P11: Stop-Process stays Unknown (the user decides on a stop-a-process action)"}
// P11: common parameters
{"name":"pwsh: Get-ChildItem src -Filter *.ts -ErrorAct... (85 chars)","tool":"PowerShell","args":{"command":"Get-ChildItem src -Filter *.ts -ErrorAction SilentlyContinue | Select-Object -First 5"},"expect":"allow","why":"P11: -Filter and -ErrorAction SilentlyContinue"}
{"name":"pwsh: Get-ChildItem -Recurse -Filter *.ts","tool":"PowerShell","args":{"command":"Get-ChildItem -Recurse -Filter *.ts"},"expect":"allow","why":"P11: -Recurse -Filter"}
