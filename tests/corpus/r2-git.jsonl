{"name":"pwsh: Write-Output x; Remove-Item a.md","tool":"PowerShell","args":{"command":"Write-Output x; Remove-Item a.md"},"expect":"allow","why":"P11: Write-Output is known, so the folder is kept"}
{"name":"pwsh: Get-Location","tool":"PowerShell","args":{"command":"Get-Location"},"expect":"allow","why":"P11: Get-Location"}
{"name":"pwsh: pwd","tool":"PowerShell","args":{"command":"pwd"},"expect":"allow","why":"P11: pwd is Get-Location"}
{"name":"pwsh: Get-Location x","tool":"PowerShell","args":{"command":"Get-Location x"},"expect":"ask","why":"P11: Get-Location takes no positional argument"}
{"name":"pwsh: Get-Command node","tool":"PowerShell","args":{"command":"Get-Command node"},"expect":"allow","why":"P11: Get-Command"}
{"name":"pwsh: Get-Process node","tool":"PowerShell","args":{"command":"Get-Process node"},"expect":"allow","why":"P11: Get-Process"}
