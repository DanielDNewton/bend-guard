{"name":"pwsh: Get-Item srcapp.ts","tool":"PowerShell","args":{"command":"Get-Item srcapp.ts"},"expect":"allow","why":"P11: Get-Item"}
{"name":"pwsh: gi src","tool":"PowerShell","args":{"command":"gi src"},"expect":"allow","why":"P11: gi"}
{"name":"pwsh: Test-Path src","tool":"PowerShell","args":{"command":"Test-Path src"},"expect":"allow","why":"P11: Test-Path"}
{"name":"pwsh: Test-Path -Path .env -PathType Leaf","tool":"PowerShell","args":{"command":"Test-Path -Path .env -PathType Leaf"},"expect":"allow","why":"P11: Test-Path -PathType"}
{"name":"pwsh: Resolve-Path src","tool":"PowerShell","args":{"command":"Resolve-Path src"},"expect":"allow","why":"P11: Resolve-Path"}
{"name":"pwsh: rvpa -Relative src","tool":"PowerShell","args":{"command":"rvpa -Relative src"},"expect":"allow","why":"P11: rvpa -Relative"}
{"name":"pwsh: Test-Path src; Remove-Item a.txt","tool":"PowerShell","args":{"command":"Test-Path src; Remove-Item a.txt"},"expect":"allow","why":"P11: a known cmdlet keeps the shell folder"}
{"name":"pwsh: Get-Item Env:PATH","tool":"PowerShell","args":{"command":"Get-Item Env:PATH"},"expect":"ask","why":"P11: a ':' drive is not modelled"}
// P11: Inert cmdlets and formatter pipelines
{"name":"pwsh: Write-Output hi","tool":"PowerShell","args":{"command":"Write-Output hi"},"expect":"allow","meaning":"Inert","why":"P11: Write-Output"}
