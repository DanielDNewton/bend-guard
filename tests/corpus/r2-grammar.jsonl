// Round 2 (P10): shell grammar. Literal variables (NAME=WORD and export NAME=WORD as whole statements),
// quoted heredocs, quoted grep patterns (never expanded by bash), and cd && (the next command runs only
// in the new folder; ; || | and a newline bring the old folder back). Commands run from the project root
// unless opts.cwds says otherwise.
// A) variables
{"name":"var: D=src; grep -rn x \"$D\"","tool":"Bash","args":{"command":"D=src; grep -rn x \"$D\""},"expect":"allow","meaning":"Known[ReadTree c:/users/user/bend2_test/src]","why":"P10: a literal variable is replaced by its value"}
{"name":"var: T=\"C:/Users/user/bend2_test/src\" && cat \"$T/app.ts\"","tool":"Bash","args":{"command":"T=\"C:/Users/user/bend2_test/src\" && cat \"$T/app.ts\""},"expect":"allow","meaning":"Known[Read c:/users/user/bend2_test/src/app.ts]","why":"P10: an assignment may be followed by &&"}
{"name":"var: export T=C:/Users/user/bend2_test/src; cat \"$T/app.ts\"","tool":"Bash","args":{"command":"export T=C:/Users/user/bend2_test/src; cat \"$T/app.ts\""},"expect":"ask","why":"P10: export NAME=WORD standing alone is read like an assignment; final round: an export reaches later programs, so it is not understood"}
{"name":"var: D=\"src\"; cd \"$D\" && ls","tool":"Bash","args":{"command":"D=\"src\"; cd \"$D\" && ls"},"expect":"allow","meaning":"Known[ChangeDir c:/users/user/bend2_test/src, ListDir c:/users/user/bend2_test/src]","why":"P10: cd to a variable, then && runs in that folder only"}
{"name":"var: D=src\\nexport E=$D/x\\ncat \"${E}.ts\"","tool":"Bash","args":{"command":"D=src\nexport E=$D/x\ncat \"${E}.ts\""},"expect":"ask","why":"P10: a value may use a known variable; ${NAME} is read too; final round: an export reaches later programs, so it is not understood"}
{"name":"var: D=specs; D=tmp; cat $D/a.txt","tool":"Bash","args":{"command":"D=specs; D=tmp; cat $D/a.txt"},"expect":"allow","meaning":"Known[Read c:/users/user/bend2_test/tmp/a.txt]","why":"P10: a reassignment replaces the value"}
{"name":"var: unset D","tool":"Bash","args":{"command":"unset D"},"expect":"allow","meaning":"Known[Inert]","why":"P10: unset of a plain name changes no file"}
{"name":"var: D=src # where the code is\\nls $D","tool":"Bash","args":{"command":"D=src # where the code is\nls $D"},"expect":"allow","meaning":"Known[ListDir c:/users/user/bend2_test/src]","why":"P10: a comment may follow an assignment"}
{"name":"var: cat \"$HOME/notes.txt\"","tool":"Bash","args":{"command":"cat \"$HOME/notes.txt\""},"expect":"allow","meaning":"Known[Read c:/users/user/notes.txt]","why":"P10: a quoted $HOME at the start of a word is the home folder"}
{"name":"var: D=specs; rm -rf \"$D\"","tool":"Bash","args":{"command":"D=specs; rm -rf \"$D\""},"expect":"deny","meaning":"DeleteTree c:/users/user/bend2_test/specs","why":"P10: the substituted path meets rule 1"}
{"name":"var: S=specs && echo x > \"$S/a.md\"","tool":"Bash","args":{"command":"S=specs && echo x > \"$S/a.md\""},"expect":"deny","meaning":"Write c:/users/user/bend2_test/specs/a.md","why":"P10: a redirect to a substituted path is a write"}
{"name":"var: D=specs\\nls\\nrm -rf $D","tool":"Bash","args":{"command":"D=specs\nls\nrm -rf $D"},"expect":"deny","meaning":"DeleteTree c:/users/user/bend2_test/specs","why":"P10: the variable is kept across lines"}
{"name":"var: K=\"C:/Users/user/.claude/bend-guard/openrouter.key\"; cat \"$K\"","tool":"Bash","args":{"command":"K=\"C:/Users/user/.claude/bend-guard/openrouter.key\"; cat \"$K\""},"expect":"deny","meaning":"Read c:/users/user/.claude/bend-guard/openrouter.key","why":"P10: self-protection sees the substituted path"}
{"name":"var: D=$(pwd); ls \"$D\"","tool":"Bash","args":{"command":"D=$(pwd); ls \"$D\""},"expect":"ask","why":"P10: a value from $(...) is not literal"}
{"name":"var: PATH=x; ls","tool":"Bash","args":{"command":"PATH=x; ls"},"expect":"ask","why":"P10: PATH may not be assigned"}
{"name":"var: IFS=/; ls","tool":"Bash","args":{"command":"IFS=/; ls"},"expect":"ask","why":"P10: IFS may not be assigned"}
{"name":"var: GIT_DIR=x; git status","tool":"Bash","args":{"command":"GIT_DIR=x; git status"},"expect":"ask","why":"P10: names starting GIT_ may not be assigned (they change what git reads)"}
{"name":"var: export NODE_OPTIONS=--require=./x.js; node --version","tool":"Bash","args":{"command":"export NODE_OPTIONS=--require=./x.js; node --version"},"expect":"ask","why":"P10: names starting NODE_ may not be assigned (node would run code)"}
{"name":"var: ls \"$UNSET\"","tool":"Bash","args":{"command":"ls \"$UNSET\""},"expect":"ask","why":"P10: a variable never assigned is refused"}
{"name":"var: true && D=src; ls $D","tool":"Bash","args":{"command":"true && D=src; ls $D"},"expect":"ask","why":"P10: an assignment after && lasts only to the end of its && chain"}
{"name":"var: D=src; true && D=specs; rm -rf $D","tool":"Bash","args":{"command":"D=src; true && D=specs; rm -rf $D"},"expect":"ask","why":"P10: after the && chain ends the value may be either, so the name is forgotten"}
{"name":"var: cd tmp && D=specs && rm -rf \"$D\"","tool":"Bash","args":{"command":"cd tmp && D=specs && rm -rf \"$D\""},"expect":"allow","meaning":"Known[ChangeDir c:/users/user/bend2_test/tmp, DeleteTree c:/users/user/bend2_test/tmp/specs]","why":"P10: an assignment after && holds for the rest of that && chain"}
{"name":"var: true && D=specs && rm -rf \"$D\"","tool":"Bash","args":{"command":"true && D=specs && rm -rf \"$D\""},"expect":"deny","meaning":"DeleteTree c:/users/user/bend2_test/specs","why":"P10: the chained value is used"}
{"name":"var: cd src && D=x; rm -rf \"$D\"","tool":"Bash","args":{"command":"cd src && D=x; rm -rf \"$D\""},"expect":"ask","why":"P10: after ; the chained assignment may not have run, so the name is forgotten"}
{"name":"var: true && D=b || ls $D","tool":"Bash","args":{"command":"true && D=b || ls $D"},"expect":"ask","why":"P10: an assignment followed by || is not read"}
{"name":"var: true && export D=src && ls $D","tool":"Bash","args":{"command":"true && export D=src && ls $D"},"expect":"ask","why":"P10: export after && works the same; final round: an export reaches later programs, so it is not understood"}
{"name":"var: D=src; ls | D=x; cat $D","tool":"Bash","args":{"command":"D=src; ls | D=x; cat $D"},"expect":"ask","why":"P10: an assignment inside a pipeline is refused and forgets the name"}
{"name":"var: X=\"a b\"; ls $X","tool":"Bash","args":{"command":"X=\"a b\"; ls $X"},"expect":"ask","why":"P10: a bare use of a value with a space would be split by bash"}
{"name":"var: D=\"a*\"; ls $D","tool":"Bash","args":{"command":"D=\"a*\"; ls $D"},"expect":"ask","why":"P10: a bare use of a value with a wildcard would be expanded by bash"}
{"name":"var: D=src; unset D; cat $D","tool":"Bash","args":{"command":"D=src; unset D; cat $D"},"expect":"ask","why":"P10: unset forgets the variable"}
{"name":"var: unset PATH; ls","tool":"Bash","args":{"command":"unset PATH; ls"},"expect":"ask","why":"P10: unset of a name that may not be assigned is not modelled"}
{"name":"var: D=src ls $D","tool":"Bash","args":{"command":"D=src ls $D"},"expect":"ask","why":"P10: the NAME=WORD cmd prefix form stays unknown"}
{"name":"var: local D=src; ls $D","tool":"Bash","args":{"command":"local D=src; ls $D"},"expect":"ask","why":"P10: local, declare and readonly stay unknown"}
{"name":"var: D=~/x; cat $D","tool":"Bash","args":{"command":"D=~/x; cat $D"},"expect":"allow","meaning":"Known[Read c:/users/user/x]","why":"P10: a ~ starting a value is the home folder, as bash expands it"}
{"name":"var: D=~/.claude/bend-guard; rm -rf \"$D\"","tool":"Bash","args":{"command":"D=~/.claude/bend-guard; rm -rf \"$D\""},"expect":"deny","meaning":"DeleteTree c:/users/user/.claude/bend-guard","why":"P10: self-protection sees the expanded ~"}
{"name":"var: D=a:~/x; ls $D","tool":"Bash","args":{"command":"D=a:~/x; ls $D"},"expect":"ask","why":"P10: a ~ after : in a value stays refused"}
{"name":"var: D=\"~\"; cat \"$D/x\"","tool":"Bash","args":{"command":"D=\"~\"; cat \"$D/x\""},"expect":"ask","why":"P10: a value with ~ is refused (bash keeps an expanded ~ literal)"}
{"name":"var: cat a$HOME","tool":"Bash","args":{"command":"cat a$HOME"},"expect":"allow","meaning":"Known[Read c:/users/user/bend2_test/a/c/users/user]","why":"P10: $HOME is the bash form (/c/Users/...), so it is exact inside a word too"}
{"name":"var: cat x$USERPROFILE","tool":"Bash","args":{"command":"cat x$USERPROFILE"},"expect":"ask","why":"P10: USERPROFILE keeps the Windows form, which cannot follow other text in a path"}
{"name":"var: D=\"$HOME/x\"; cat \"$D\"","tool":"Bash","args":{"command":"D=\"$HOME/x\"; cat \"$D\""},"expect":"allow","meaning":"Known[Read c:/users/user/x]","why":"P10: $HOME may be used in a value"}
{"name":"var: D=$HOME/.claude/bend-guard; cat $D/openrouter.key","tool":"Bash","args":{"command":"D=$HOME/.claude/bend-guard; cat $D/openrouter.key"},"expect":"deny","meaning":"Read c:/users/user/.claude/bend-guard/openrouter.key","why":"P10: self-protection sees a path built from $HOME"}
{"name":"var: D=specs; rm -rf \"$D\" {\"agent\":true}","tool":"Bash","args":{"command":"D=specs; rm -rf \"$D\""},"opts":{"agent":true},"expect":"deny","why":"P10: also refused for a subagent"}
// B) heredocs
{"name":"heredoc: cat > tmp/a.txt <<'EOF'\\nhello $HOME `x` $(y)\\nEOF","tool":"Bash","args":{"command":"cat > tmp/a.txt <<'EOF'\nhello $HOME `x` $(y)\nEOF"},"expect":"allow","meaning":"Known[Write c:/users/user/bend2_test/tmp/a.txt]","why":"P10: a quoted heredoc body is literal standard input"}
{"name":"heredoc: cat <<\"EOF\" > tmp/b.txt\\nx\\nEOF","tool":"Bash","args":{"command":"cat <<\"EOF\" > tmp/b.txt\nx\nEOF"},"expect":"allow","meaning":"Known[Write c:/users/user/bend2_test/tmp/b.txt]","why":"P10: a double-quoted end word works the same"}
{"name":"heredoc: cat <<-'EOF' > tmp/b.txt\\n\tx\\n\tEOF\\nls","tool":"Bash","args":{"command":"cat <<-'EOF' > tmp/b.txt\n\tx\n\tEOF\nls"},"expect":"allow","meaning":"Known[Write c:/users/user/bend2_test/tmp/b.txt, ListDir c:/users/user/bend2_test]","why":"P10: <<- strips leading tabs, also from the end line"}
{"name":"heredoc: cat <<EOF > tmp/c.txt\\nplain text\\nEOF","tool":"Bash","args":{"command":"cat <<EOF > tmp/c.txt\nplain text\nEOF"},"expect":"allow","meaning":"Known[Write c:/users/user/bend2_test/tmp/c.txt]","why":"P10: a bare end word is allowed when the body has no $ ` or \\"}
{"name":"heredoc: cat > tmp/a.txt <<'EOF'\\nrm -rf specs\\nEOF","tool":"Bash","args":{"command":"cat > tmp/a.txt <<'EOF'\nrm -rf specs\nEOF"},"expect":"allow","meaning":"Known[Write c:/users/user/bend2_test/tmp/a.txt]","why":"P10: commands written in the body are data, not commands"}
{"name":"heredoc: cat > tmp/a.txt <<'EOF'\\nx\\nEOF\\nrm -rf specs","tool":"Bash","args":{"command":"cat > tmp/a.txt <<'EOF'\nx\nEOF\nrm -rf specs"},"expect":"deny","meaning":"DeleteTree c:/users/user/bend2_test/specs","why":"P10: the line after the end word is a command again"}
{"name":"heredoc: cat > specs/a.md <<'EOF'\\nx\\nEOF","tool":"Bash","args":{"command":"cat > specs/a.md <<'EOF'\nx\nEOF"},"expect":"deny","meaning":"Write c:/users/user/bend2_test/specs/a.md","why":"P10: cat > F <<EOF writes F (rule 1)"}
{"name":"heredoc: cat > ~/.claude/local-plugins/x <<'EOF'\\nx\\nEOF","tool":"Bash","args":{"command":"cat > ~/.claude/local-plugins/x <<'EOF'\nx\nEOF"},"expect":"deny","meaning":"Write c:/users/user/.claude/local-plugins/x","why":"P10: cat > F <<EOF writes F (self-protection)"}
{"name":"heredoc: cat <<EOF\\n$HOME\\nEOF","tool":"Bash","args":{"command":"cat <<EOF\n$HOME\nEOF"},"expect":"ask","why":"P10: a bare end word with $ in the body is refused"}
{"name":"heredoc: cat <<EOF\\na\\b\\nEOF","tool":"Bash","args":{"command":"cat <<EOF\na\\b\nEOF"},"expect":"ask","why":"P10: a bare end word with \\ in the body is refused"}
{"name":"heredoc: cat <<'EOF'\\nno end","tool":"Bash","args":{"command":"cat <<'EOF'\nno end"},"expect":"ask","why":"P10: a heredoc with no end line is refused"}
{"name":"heredoc: cat <<'EOF'","tool":"Bash","args":{"command":"cat <<'EOF'"},"expect":"ask","why":"P10: a heredoc with no body is refused"}
{"name":"heredoc: python - <<'EOF'\\nprint(1)\\nEOF","tool":"Bash","args":{"command":"python - <<'EOF'\nprint(1)\nEOF"},"expect":"ask","why":"P10: python reading a script from the heredoc stays unknown"}
{"name":"heredoc: cat <<'A' <<'B'\\nx\\nA\\ny\\nB","tool":"Bash","args":{"command":"cat <<'A' <<'B'\nx\nA\ny\nB"},"expect":"ask","why":"P10: only one heredoc per command"}
{"name":"heredoc: cat <<<\"x\"","tool":"Bash","args":{"command":"cat <<<\"x\""},"expect":"ask","why":"P10: a here-string stays refused"}
{"name":"heredoc: cat 0<<EOF\\nx\\nEOF","tool":"Bash","args":{"command":"cat 0<<EOF\nx\nEOF"},"expect":"ask","why":"P10: a descriptor before << is refused"}
{"name":"heredoc: cat <<E\"OF\"\\nx\\nEOF","tool":"Bash","args":{"command":"cat <<E\"OF\"\nx\nEOF"},"expect":"ask","why":"P10: an end word that is partly quoted is refused"}
// C) quoted wildcards in grep patterns
{"name":"glob: grep -rn \"foo.*bar\" src","tool":"Bash","args":{"command":"grep -rn \"foo.*bar\" src"},"expect":"allow","meaning":"Known[ReadTree c:/users/user/bend2_test/src]","why":"P10: a quoted pattern is never expanded, so there is no ReadTree of the current folder"}
{"name":"glob: grep -n 'a*' src/app.ts","tool":"Bash","args":{"command":"grep -n 'a*' src/app.ts"},"expect":"allow","meaning":"Known[Read c:/users/user/bend2_test/src/app.ts]","why":"P10: single quotes too"}
