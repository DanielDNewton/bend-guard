{"name":"glob: grep -rn -e \"x[0-9]\" src","tool":"Bash","args":{"command":"grep -rn -e \"x[0-9]\" src"},"expect":"allow","meaning":"Known[ReadTree c:/users/user/bend2_test/src]","why":"P10: a quoted -e value too"}
{"name":"glob: P=\"a.*b\"; grep -rn \"$P\" src","tool":"Bash","args":{"command":"P=\"a.*b\"; grep -rn \"$P\" src"},"expect":"allow","meaning":"Known[ReadTree c:/users/user/bend2_test/src]","why":"P10: a quoted use of a variable holding a wildcard"}
{"name":"glob: grep a* src/app.ts","tool":"Bash","args":{"command":"grep a* src/app.ts"},"expect":"ask","why":"P10: an unquoted wildcard may expand into file names"}
{"name":"glob: grep -rn foo.*bar src","tool":"Bash","args":{"command":"grep -rn foo.*bar src"},"expect":"ask","why":"P10: an unquoted wildcard may expand into file names"}
{"name":"glob: grep \"a*\" a*","tool":"Bash","args":{"command":"grep \"a*\" a*"},"expect":"ask","why":"P10: the same text also appears unquoted, so it is not trusted"}
{"name":"glob: cat \"a*\"","tool":"Bash","args":{"command":"cat \"a*\""},"expect":"ask","why":"P10: path operands are unchanged: a quoted wildcard in a path is still read as a wildcard (stricter)"}
