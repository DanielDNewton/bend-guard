{"name":"r2-measure: git add of .env denies","tool":"Bash","args":{"command":"git add .env"},"expect":"deny","meaning":"ReadTree c:/users/user/bend2_test/.env","why":"P8: git add is a ReadTree of each path; rule 2"}
