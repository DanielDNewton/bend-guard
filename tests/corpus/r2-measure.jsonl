{"name":"r2-measure: find -exec asks","tool":"Bash","args":{"command":"find . -exec rm {} ;"},"expect":"ask","why":"P9: -exec keeps find Unknown"}
{"name":"r2-measure: find -L (follow links) asks","tool":"Bash","args":{"command":"find -L . -name x"},"expect":"ask","why":"P9: -L follows links, refused from the grammar"}
